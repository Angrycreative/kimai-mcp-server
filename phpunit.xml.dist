<?xml version="1.0" encoding="UTF-8"?>
<!--
    Runs against an existing Kimai checkout, which supplies Kimai's classes and Symfony:

        KIMAI_DIR=/path/to/kimai tools/qa/vendor/bin/phpunit

    Install the tools once with: composer install -d tools/qa
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="tools/qa/vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnRisky="true">
    <testsuites>
        <testsuite name="McpServerBundle">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>Capacity</directory>
            <directory>CallLog</directory>
            <directory>Category</directory>
            <directory>People</directory>
            <directory>Planner</directory>
            <directory>Server</directory>
            <directory>Settings</directory>
            <directory>Support</directory>
            <directory>Tool</directory>
        </include>
    </source>
</phpunit>
